# Copy to .env (`uv run vlm init`) and adjust. Every value has a default in
# src/abliterated_vlm/config.py, so this file only needs what you change.

# --- Model -------------------------------------------------------------------
MODEL_REPO=huihui-ai/Huihui-Qwen3.8-27B-abliterated-GGUF
# Biggest 4-bit quant in the repo (19.5 GiB): Q4_K with the abliterated tensors kept at Q8_0.
MODEL_FILE=Huihui-Qwen3.8-27B-abliterated-Q4_K_L.gguf
# Vision projector, only loaded when ENABLE_VISION=1 (costs ~1 GiB of VRAM).
MMPROJ_FILE=mmproj-model-bf16.gguf
MODELS_DIR=models
# Name the API reports and OpenCode refers to.
MODEL_ALIAS=huihui-qwen3.8-27b

# --- Server ------------------------------------------------------------------
# Keep 127.0.0.1: the laptop reaches it through an SSH tunnel, nothing is exposed on the LAN.
HOST=127.0.0.1
PORT=8080
# Optional bearer token required by the API (leave empty to disable).
API_KEY=

# --- Performance (RTX 3090, 24 GiB) -------------------------------------------
# Measured VRAM on the RTX 3090 (q8_0 KV cache):
#   65536 -> 21.6 GiB, +vision 22.7 GiB | 98304 -> 22.8 GiB | 131072 -> 24.0 GiB (too tight)
# With ENABLE_VISION=1 use 65536.
CTX_SIZE=98304
N_GPU_LAYERS=999
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
PARALLEL=1
ENABLE_VISION=0
# Any extra llama-server flags, space separated.
EXTRA_ARGS=

# --- llama.cpp build -----------------------------------------------------------
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_CPP_REF=master
# 86 = RTX 3090 (Ampere). Building for one architecture keeps compile time short.
CUDA_ARCHITECTURES=86
